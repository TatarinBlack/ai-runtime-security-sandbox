# Copy this file to .env and fill in the keys for whichever providers you plan to use.
# Providers left blank still show up in the UI, but return a friendly error if selected.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Custom / OpenAI-compatible endpoint (Ollama, LM Studio, Azure OpenAI, vLLM, etc.) ---
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=ollama
CUSTOM_MODEL=llama3.1

# Server settings
APP_HOST=127.0.0.1
APP_PORT=8000
